;;-*-Lisp-*-
(in-package goal)

;; name: mod-custom-code.gc
;; name in dgo: mod-custom-code
;; dgos: GAME

;; Multiplayer-enabled custom code for Jak 2

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Multiplayer State Updates
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun update-state ()
  (if (and (= *cheat-mode* #f) (= *debug-segment* #f))
    (set! (-> *teamrun-info* debug_mode_active?) 0)
    (set! (-> *teamrun-info* debug_mode_active?) 1)
    )

  ;; Jak 2 uses different game-info fields than Jak 1
  (set! (-> *teamrun-info* cell_count) (the int32 (-> *game-info* fuel)))      ;; missions/cells
  (set! (-> *teamrun-info* buzzer_count) (the int32 (-> *game-info* gem)))      ;; skull gems
  (set! (-> *teamrun-info* money_count) (the int32 (-> *game-info* money)))     ;; precursor orbs
  (set! (-> *teamrun-info* death_count) (the int32 (-> *game-info* total-deaths)))

  (set! (-> *teamrun-info* has_state_update?) 1)
  (set! *has-none-position-update?* #t)
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Interaction Buffer System
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun add-interaction-to-buffer ((type interaction-type) (amount float) (status float) (name string) (level string) (parent string))
  (if *self-setup-completed*
    (dotimes (idx (-> *interaction-update-buffer* length))
      (when (= (-> *interaction-update-buffer* idx has_update?) #f)

        (set! (-> *interaction-update-buffer* idx type) type)
        (set! (-> *interaction-update-buffer* idx amount) amount)
        (set! (-> *interaction-update-buffer* idx status) status)
        (mp-copy-string! (-> *interaction-update-buffer* idx ename) name)
        (mp-copy-string! (-> *interaction-update-buffer* idx level) level)
        (mp-copy-string! (-> *interaction-update-buffer* idx parent) parent)

        (set! (-> *interaction-update-buffer* idx has_update?) #t)
        (return #t)
        )
      )
    )
    (none)
  )

(defun check-set-interaction-from-buffer ()
  (if *self-setup-completed*
    (dotimes (idx (-> *interaction-update-buffer* length))
      (when (= (-> *interaction-update-buffer* idx has_update?) #t)

        (set! (-> *self-player-info* inter_type) (-> *interaction-update-buffer* idx type))
        (set! (-> *self-player-info* inter_amount) (-> *interaction-update-buffer* idx amount))
        (set! (-> *self-player-info* inter_status) (-> *interaction-update-buffer* idx status))
        (mp-copy-string! (-> *self-player-info* inter_name) (-> *interaction-update-buffer* idx ename))
        (mp-copy-string! (-> *self-player-info* inter_parent) (-> *interaction-update-buffer* idx parent))
        (mp-copy-string! (-> *self-player-info* inter_level) (-> *interaction-update-buffer* idx level))

        (set! *has-none-position-update?* #t)

        (set! (-> *interaction-update-buffer* idx has_update?) #f)
        (return #t)
        )
      )
    )
  (none)
)

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Shared World Pickups
;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-extern get-current-level-name (function string))
(define-extern coop-init (function none)) ;; mod-coop
(define-extern coop-update (function none))

(defun mp-on-local-pickup ((this process-drawable))
  "Called from collectable do-pickup. Sends orb/gem pickups with the entity name so teammates remove the same item."
  (when (and *self-setup-completed* (type? this collectable))
    (let* ((c (the-as collectable this))
           (ptype (-> c fact pickup-type)))
      (when (or (= ptype (pickup-type gem)) (= ptype (pickup-type skill)))
        (add-interaction-to-buffer
          (if (= ptype (pickup-type gem)) (interaction-type gem) (interaction-type skill))
          (-> c fact pickup-amount)
          0.0
          ;; only placed items have their own entity, drops (crates/enemies) just sync the counter
          (if (and (-> c entity) (= c (-> c entity extra process)))
            (res-lump-struct (-> c entity) 'name string)
            ""
            )
          (get-current-level-name)
          "entity-pool"
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Shared Combat (phase 3)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant MP_ENEMY_HP_PER_PLAYER 0.5) ;; extra enemy health per extra player (2 players = x1.5)

(defun mp-type-is? ((t type) (name symbol))
  "Does type t (or one of its parents) have this name? Lets us test for types defined in level code (like bot)."
  (while (and t (!= t object))
    (if (= (-> t symbol) name)
      (return #t)
      )
    (set! t (-> t parent))
    )
  #f
  )

(defun mp-coop-enemy? ((this process-drawable))
  "Enemies we share: placed in the map (own entity), not allies (bot: kid, kor, escorts...) and not bosses."
  (and (-> this entity)
       (= this (-> this entity extra process))
       (not (mp-type-is? (-> this type) 'bot))
       (not (mp-type-is? (-> this type) 'krew-boss))
       (not (mp-type-is? (-> this type) 'krew-boss-clone))
       )
  )

(defun mp-player-count ()
  (let ((n 1))
    (dotimes (idx MAX_MULTIPLAYER_COUNT)
      (if (and (!= idx (-> *multiplayer-info* player_num)) (is-interactive? idx))
        (+! n 1)
        )
      )
    n
    )
  )

(defun mp-scale-enemy-hp ((this process-drawable) (hp int))
  "Called from enemy init. More players = tougher enemies, so killing them together isn't trivial."
  (if (and *self-setup-completed* (> hp 0) (> (mp-player-count) 1)
           (not (mp-type-is? (-> this type) 'bot))
           (not (mp-type-is? (-> this type) 'krew-boss))
           (not (mp-type-is? (-> this type) 'krew-boss-clone)))
    (the int (+ 0.999 (* (the float hp) (+ 1.0 (* MP_ENEMY_HP_PER_PLAYER (the float (+ (mp-player-count) -1)))))))
    hp
    )
  )

(defun mp-on-enemy-dying ((this process-drawable))
  "Called from enemy dying. Remote kills are pre-flagged spawn-gem (see mp-kill-remote-enemy), so they aren't echoed back."
  (when (and *self-setup-completed* (type? this enemy) (mp-coop-enemy? this)
             (not (logtest? (enemy-flag spawn-gem) (-> (the-as enemy this) enemy-flags))))
    (add-interaction-to-buffer
      (interaction-type enemy-death)
      1.0
      0.0
      (res-lump-struct (-> this entity) 'name string)
      (get-current-level-name)
      "entity-pool"
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Task Completion Polling
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun init-task-tracker ()
  "Record all currently completed tasks so we don't send them as new on first frame"
  (dotimes (idx MAX_GAME_TASKS)
    (if (task-complete? *game-info* (the-as game-task idx))
      (set! (-> *task-tracker* sent idx) (the uint8 1))
      (set! (-> *task-tracker* sent idx) (the uint8 0))
      )
    )
  (set! *prev-fuel* (the int (-> *game-info* fuel)))
  (set! *prev-gem-count* (the int (-> *game-info* gem)))
  (set! *prev-money-count* (the int (-> *game-info* skill)))
  (set! *tracker-initialized* #t)
  (none)
  )

(defun get-current-level-name ()
  "Get the current level name as a string, or empty string if unavailable"
  (if (level-get-target-inside *level*)
    (symbol->string (-> (level-get-target-inside *level*) name))
    ""
    )
  )

(defconstant MP_MAX_LIVE_TASKS 2) ;; more new tasks than this in one frame = a save was loaded
(defconstant MP_MAX_LIVE_PICKUPS 5) ;; same idea for gem/orb counters

(defun check-task-completions ()
  "Poll the task list for newly completed missions and send them to teammates"
  (let ((new-count 0))
    (dotimes (idx MAX_GAME_TASKS)
      (if (and (task-complete? *game-info* (the-as game-task idx)) (zero? (-> *task-tracker* sent idx)))
        (+! new-count 1)
        )
      )
    (dotimes (idx MAX_GAME_TASKS)
      (when (and (task-complete? *game-info* (the-as game-task idx)) (zero? (-> *task-tracker* sent idx)))
        (set! (-> *task-tracker* sent idx) (the uint8 1))
        (if (<= new-count MP_MAX_LIVE_TASKS)
          (add-interaction-to-buffer
            (interaction-type game-task)
            (the float idx)
            0.0
            (game-task->string (the-as game-task idx))
            (get-current-level-name)
            "entity-pool"
            )
          )
        )
      )
    )
  (none)
  )

(defun check-gem-pickups ()
  "Poll for skull gem count changes and send interaction data"
  (let* ((current-gems (the int (-> *game-info* gem)))
         (diff (- current-gems *prev-gem-count*)))
    (when (and (> diff 0) (<= diff MP_MAX_LIVE_PICKUPS))
      (add-interaction-to-buffer (interaction-type gem) (the float diff) 0.0 "gem" (get-current-level-name) "entity-pool")
      )
    (set! *prev-gem-count* current-gems)
    )
  (none)
  )

(defun check-money-pickups ()
  "Poll for precursor orb (skill) count changes and send interaction data"
  (let* ((current-orbs (the int (-> *game-info* skill)))
         (diff (- current-orbs *prev-money-count*)))
    (when (and (> diff 0) (<= diff MP_MAX_LIVE_PICKUPS))
      (add-interaction-to-buffer (interaction-type skill) (the float diff) 0.0 "skill" (get-current-level-name) "entity-pool")
      )
    (set! *prev-money-count* current-orbs)
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Multiplayer Initialization
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun init-multiplayer ()
  (when (not *self-setup-completed*)
    ;; local player is always slot 0, the C++ side maps remote players to slots 1+
    ;; (left at -1 the socket handler would write self info out of bounds)
    (set! (-> *multiplayer-info* player_num) 0)
    (set! (-> *self-player-info* mp_state) (mp-tgt-state mp-tgt-interactive))
    (set! (-> *self-player-info* mp_state_check) (mp-tgt-state mp-tgt-interactive))
    (coop-init) ;; before the handshake, the relay sends our co-op role right after it
    (pc-connect-mp-info *multiplayer-info* *self-player-info* *teamrun-info* *teamrun-levels-info*)
    (set! *self-setup-completed* #t)
    (format 0 "Jak 2 Multiplayer initialized~%")
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Self Position Update
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun update-self-multiplayer-info ()
  (when (and *target* *self-setup-completed*)
    ;; update position from target transform
    (set! (-> *self-player-info* trans_x) (-> *target* control trans x))
    (set! (-> *self-player-info* trans_y) (-> *target* control trans y))
    (set! (-> *self-player-info* trans_z) (-> *target* control trans z))

    ;; update quaternion from target root
    (set! (-> *self-player-info* quat_x) (-> *target* control quat x))
    (set! (-> *self-player-info* quat_y) (-> *target* control quat y))
    (set! (-> *self-player-info* quat_z) (-> *target* control quat z))
    (set! (-> *self-player-info* quat_w) (-> *target* control quat w))

    ;; animation: jakb art group index in tgt_state, frame in zoomer_rot_y (see mod-remote-player)
    (set! (-> *self-player-info* tgt_state)
          (the-as symbol (target-anim-index *target*)))
    (set! (-> *self-player-info* zoomer_rot_y) (target-anim-frame *target*))

    ;; update current level
    (when (level-get-target-inside *level*)
      (when (!= (-> *self-player-info* current_level) (-> (level-get-target-inside *level*) name))
        (set! (-> *self-player-info* current_level) (-> (level-get-target-inside *level*) name))
        (set! (-> *multiplayer-info* players (-> *multiplayer-info* player_num) current_level) (-> *self-player-info* current_level))
        )
      )

    ;; update level loading info
    (set! (-> *teamrun-levels-info* has_level_update?) 1)

    (update-state)
    (pc-update-position)
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Level Entry Hook
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun runs-on-level-enter ()
  (when (and *target* *self-setup-completed* (!= (-> (level-get-target-inside *level*) name) 'title))
    (when (!= (-> *self-player-info* current_level) (-> (level-get-target-inside *level*) name))
      (set! (-> *self-player-info* current_level) (-> (level-get-target-inside *level*) name))
      (set! (-> *multiplayer-info* players (-> *multiplayer-info* player_num) current_level) (-> *self-player-info* current_level))
      )
    (set! *allow-cell-pickup?* (or (= (-> *multiplayer-info* game require_same_level) 0) (all-teammates-in-same-level?)))
    (set! *allow-orb-pickup?* (or (= (-> *multiplayer-info* game require_same_level) 0) (all-teammates-in-same-level?)))
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Main Frame Loop
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun runs-every-frame ()
  ;; Initialize multiplayer connection if not yet done
  (when (and *target* (not *self-setup-completed*))
    (init-multiplayer)
    )

  ;; Process multiplayer commands
  (when *self-setup-completed*
    (execute-teamrun-command)

    ;; Update and send position if not paused
    (when (not *pause-multiplayer-logic*)
      ;; Initialize task tracker on first active frame
      (when (not *tracker-initialized*)
        (init-task-tracker)
        )

      ;; Poll for game state changes and send interactions
      (check-task-completions)
      ;; orb/gem pickups are sent from mp-on-local-pickup (collectables do-pickup hook)
      (process-pending-remote-pickups)

      ;; Drain interaction buffer to self-player-info
      (check-set-interaction-from-buffer)

      ;; Teammates: draw them and apply their progress
      (render-remote-players)
      (handle-remote-interactions)
      (coop-update)
      (mp-draw-gate-message)

      ;; Update and send position
      (update-self-multiplayer-info)

      ;; Cleanup self interaction data after it's been sent
      (if (!= (-> *self-player-info* inter_type) (interaction-type none))
        (clean-up-interaction-data *self-player-info*)
        )
      )
    )

  ;; Input display
  (if *show-input-display*
    (input-display-on)
    (input-display-off)
    )

  (when *debug-segment*
    (orb-placer-maintenance)
    )

  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Game Event Hooks
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun runs-on-gem-pickup ()
  (when *self-setup-completed*
    (update-state)
    )
  (none)
  )

(defun runs-on-task-close ()
  (when *self-setup-completed*
    (update-state)
    )
  (none)
  )

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (when *self-setup-completed*
    (update-state)
    )
  (none)
  )

(defun runs-on-jak-spawn ()
  (when *self-setup-completed*
    (set! (-> *teamrun-info* just_spawned?) 1)
    (update-state)
    )
  (none)
  )

(defun runs-on-jak-death ((death-event symbol))
  (when *self-setup-completed*
    (case death-event
      (('dying)
        (update-state)
        )
      (('blackout)
        (update-state)
        )
      )
    )
  (none)
  )

(defun runs-on-save ((save-event symbol))
  (case save-event
    (('save-start)
      (set! *pause-multiplayer-logic* #t)
      )
    (('save-end)
      (set! *pause-multiplayer-logic* #f)
      (set! *player-can-load* #t)
      (set! (-> *teamrun-info* just_saved?) 1)
      (update-state)
      )
    )
  (none)
  )

(defun runs-on-load ((load-event symbol))
  (case load-event
    (('load-start)
      (set! *pause-multiplayer-logic* #t)
      )
    (('load-end)
      (set! *pause-multiplayer-logic* #f)
      (set! (-> *teamrun-info* just_loaded?) 1)
      ;; a loaded save isn't new progress, re-baseline so it isn't broadcast
      (set! *tracker-initialized* #f)
      (update-state)
      )
    )
  (none)
  )

(defun runs-on-debug-toggle ()
  (update-state)
  (none)
  )
